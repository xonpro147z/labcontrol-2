{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabControl",
  "version": "3.1.2",
  "identifier": "vn.labcontrol.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LabControl",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "publisher": "Dự án LabControl",
    "category": "Education",
    "shortDescription": "Quản lý phòng máy tập trung",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Vietnamese",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "perMachine"
      }
    },
    "copyright": "© 2026 Ngô Văn Hưng và những người đóng góp. Giấy phép AGPL-3.0-or-later.",
    "licenseFile": "../../LICENSE",
    "resources": [
      "resources/agent/**/*"
    ]
  }
}